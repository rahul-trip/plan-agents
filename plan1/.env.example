# Copy to .env. Only needed for live runs; tests use a scripted fake LLM.
# Format is provider:model. Set exactly one LLM_MODEL.
LLM_MODEL=anthropic:claude-opus-5-5
# LLM_MODEL=openai:<model-name>
# LLM_MODEL=openai-compatible:<model-name>
# LLM_MODEL=ollama:<a-model-from-ollama-list>

ANTHROPIC_API_KEY=

# OpenAI & OpenAI-compatible inference providers (e.g. vLLM, LM Studio, Ollama, LocalAI, OpenRouter, Groq, Together):
# baseurl: Endpoint URL of the inference service (e.g., http://localhost:8000/v1, http://localhost:1234/v1)
OPENAI_BASE_URL=
# BASE_URL=

# api key: Your API key. Leave blank or empty for local services that do not require auth (defaults to dummy/EMPTY).
OPENAI_API_KEY=
# API_KEY=

# Optional: customize structured output method if your service does not support json_schema (e.g. function_calling)
# LLM_STRUCTURED_METHOD=json_schema

# Optional: raises the GitHub API rate limit for the Stage 1 live lab.
GITHUB_TOKEN=

# Stage 5. Matches docker-compose.yml (dev-only credentials).
POSTGRES_URL=postgresql://planagents:planagents@localhost:55432/planagents
